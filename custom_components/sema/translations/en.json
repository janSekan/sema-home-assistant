{
  "config": {
    "step": {
      "user": {
        "title": "Connect SEMA",
        "description": "Enter the local SEMA address, including http:// or https://, and the dedicated Home Assistant token. Use a trusted LAN when connecting over HTTP.",
        "data": {
          "host": "SEMA address",
          "access_token": "Home Assistant token"
        }
      },
      "reconfigure": {
        "title": "Change SEMA connection",
        "description": "Change the address of the same SEMA device. Leave the token empty to keep the current one.",
        "data": {
          "host": "SEMA address",
          "access_token": "New token (optional)"
        }
      },
      "reauth_confirm": {
        "title": "Renew SEMA authentication",
