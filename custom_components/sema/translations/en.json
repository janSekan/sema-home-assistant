        "data": {
          "host": "SEMA address",
          "access_token": "New Home Assistant token"
        }
      },
      "discovery_confirm": {
        "title": "Discovered SEMA device",
        "description": "SEMA was found at {host}. Enter its dedicated Home Assistant token. Use a trusted LAN when connecting over HTTP.",
        "data": {
          "access_token": "Home Assistant token"
        }
      }
    },
    "error": {
      "invalid_url": "Enter a full HTTP(S) address without a path, query or login credentials.",
